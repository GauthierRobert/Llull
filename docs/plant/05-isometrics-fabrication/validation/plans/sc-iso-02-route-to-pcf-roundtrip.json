{
  "id": "SC-ISO-02",
  "validates": ["VC-ISO-04", "VC-ISO-17"],
  "description": "Route L-101 DN100 in llull with the same geometry as the sample PCF (main run with three 90 deg turns, a vertical branch at x = 7105), let routing place LR elbows, an equal tee and weld-neck flanges from the spec, add a site weld at x = 2500, export the PCF and re-import it as a preview. Pipe length must equal route length minus fitting take-outs.",
  "status": "UNBUILT - depends on 01-piping-specs-catalog (spec CS150-A1) and 02-spec-driven-routing (fittings, flanges, branch); names of RTE commands are placeholders owned by that pack",
  "unbuilt": ["import_pipe_spec (PSC)", "add_pipe_run.spec (PSC)", "add_branch (RTE)", "add_end_flange (RTE)", "add_field_weld", "piping_bom"],
  "actions": [
    { "command": "add_level", "params": { "name": "Grade", "elevation": 0 } },
    { "command": "import_pipe_spec", "params": { "spec": "<01-piping-specs-catalog/validation/data/sample_spec_cs150.json>" } },
    {
      "command": "add_pipe_run",
      "params": { "points": [[0, 0, 3000], [5000, 0, 3000], [5000, 4000, 3000], [5000, 4000, 1000], [8000, 4000, 1000]], "dn": 100, "line": "L-101", "service": "process" },
      "as": "main"
    },
    { "command": "add_branch", "params": { "pipeId": "$main", "at": [7105, 4000, 1000], "to": [7105, 4000, 1500], "fitting": "tee" }, "as": "branch" },
    { "command": "add_end_flange", "params": { "lineId": "L-101", "at": [[0, 0, 3000], [8000, 4000, 1000], [7105, 4000, 1500]], "type": "weld_neck" } },
    { "command": "add_field_weld", "params": { "lineId": "L-101", "at": [2500, 0, 3000], "type": "field" } },
    { "command": "export_pcf", "params": { "lineIds": ["L-101"] }, "as": "pcf" },
    { "command": "import_pcf", "params": { "text": "=$pcf.data.files[0].content", "preview": true } },
    { "command": "piping_bom", "params": { "scope": "line", "lineId": "L-101" } }
  ],
  "expected": [
    { "step": 6, "path": "data.files.length", "value": 1, "source": "one PCF per line (S12)" },
    { "step": 7, "path": "data.countsByType", "value": { "FLANGE": 3, "PIPE": 7, "WELD": 1, "ELBOW": 3, "TEE": 1 }, "source": "same topology as the sample" },
    { "step": 7, "path": "data.totalPipeLengthMm", "value": 13045.0, "abs": 1e-6, "source": "14500 route - 1455 take-out (VC-ISO-04)" },
    { "step": 8, "path": "data.rows[itemCode~PIPE].quantity", "value": 13.045, "abs": 1e-9, "source": "VC-ISO-08" }
  ],
  "determinism": "run twice: data.files[0].sha256 equal (VC-ISO-17)"
}
