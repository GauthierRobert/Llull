{
  "id": "SC-PST-01",
  "validates": ["VC-PST-12", "VC-PST-18"],
  "description": "DN150 (NPS 6 Sch 40, 168.3 x 7.11 mm) L-bend 6 m x 3 m between two anchors, sharp corner, thermal strain 0.00225 (1.2e-5 /K x 187.5 K): anchor reactions and maximum expansion stress against the unit-load flexibility closed form (Euler-Bernoulli reference; the model is Timoshenko, hence the 2 % tolerance)",
  "actions": [
    { "command": "add_level", "params": { "name": "Rack", "elevation": 0 } },
    {
      "command": "add_pipe_run",
      "params": {
        "points": [
          [0, 0, 3000],
          [6000, 0, 3000],
          [6000, 3000, 3000]
        ],
        "dn": 150,
        "line": "P-0701",
        "service": "hot oil"
      },
      "as": "pipe"
    },
    {
      "command": "create_stress_model",
      "params": {
        "name": "P-0701 flexibility",
        "pipeIds": ["$pipe"],
        "rule": "B31.3-2018",
        "elbowRadiusFactor": 0,
        "frictionCoefficient": 0.3
      },
      "as": "stress"
    },
    {
      "command": "set_pipe_operating_conditions",
      "params": {
        "modelId": "$stress",
        "installTempC": 20,
        "temperatures": [{ "name": "T1", "tempC": 207.5 }],
        "pressures": [{ "name": "P1", "gaugeBar": 0 }],
        "fluidDensityKgM3": 0,
        "cycles": 7000,
        "corrosionAllowanceMm": 0,
        "wallMm": 7.11,
        "material": { "youngsModulusMPa": 200000, "ShMPa": 138, "ScMPa": 138, "thermal": { "meanCtePerK": 1.2e-5 } }
      }
    },
    { "command": "add_stress_restraint", "params": { "modelId": "$stress", "at": { "pipeId": "$pipe", "atMm": 0 }, "kind": "anchor" } },
    { "command": "add_stress_restraint", "params": { "modelId": "$stress", "at": { "pipeId": "$pipe", "atMm": 9000 }, "kind": "anchor" } },
    { "command": "set_stress_load_cases", "params": { "modelId": "$stress", "preset": "b31.3-default" } },
    { "command": "analyze_pipe_stress", "params": { "modelId": "$stress", "cases": ["L3"], "include": ["reactions", "stresses"] } },
    { "command": "check_pipe_stress", "params": { "modelId": "$stress" } }
  ],
  "expected": [
    {
      "step": 7,
      "path": "data.details.reactions[case=L3,nodeId=N4].forceN.0",
      "value": -7872.99,
      "rel": 0.02,
      "source": "data/lbend_guided_cantilever.json (unit-load flexibility, Euler-Bernoulli); the Timoshenko model gives -7772.37"
    },
    { "step": 7, "path": "data.details.reactions[case=L3,nodeId=N4].forceN.1", "value": -2406.95, "rel": 0.02, "source": "same" },
    {
      "step": 7,
      "path": "data.details.stresses[case=L3,node=N4].stressMPa",
      "value": 106.791,
      "rel": 0.02,
      "source": "M_C / Z, no SIF (sharp corner)"
    },
    { "step": 7, "path": "data.reviewRequired", "value": true, "source": "AF-33" },
    {
      "step": 8,
      "path": "data.items[code=PST_MATERIAL_UNVERIFIED].severity",
      "value": "warn",
      "source": "a constant secant coefficient is not a sourced record (AF-32)"
    },
    {
      "step": 8,
      "path": "data.items[code=PST_EXPANSION_OVERSTRESS].severity",
      "value": "absent",
      "source": "106.79 < S_A (eq. 1b, above 1.25 Sc + 0.25 Sh = 207 MPa)"
    },
    { "step": 8, "path": "data.ok", "value": true, "source": "no fail item" }
  ]
}
