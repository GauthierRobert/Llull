{
  "id": "SC-PST-04",
  "validates": ["VC-PST-11", "VC-PST-18"],
  "description": "6 m DN100 cantilever anchored at x = 0 with a one-way +Z rest at the free end. A downward 1 kN force at mid-span loads the rest with the propped-cantilever reaction 5P/16 = 312.5 N; an upward force lifts it off (reaction 0, PST_SUPPORT_LIFTOFF). Then the agent-first guardrails: named defaults listed, stale results after an edit, approval refused to an agent (PST_HUMAN_GATE)",
  "actions": [
    { "command": "add_level", "params": { "name": "Grade", "elevation": 0 } },
    {
      "command": "add_pipe_run",
      "params": {
        "points": [
          [0, 0, 2000],
          [6000, 0, 2000]
        ],
        "dn": 100,
        "line": "U-0704"
      },
      "as": "pipe"
    },
    {
      "command": "create_stress_model",
      "params": { "name": "lift-off", "pipeIds": ["$pipe"], "rule": "B31.3-2018", "elbowRadiusFactor": 0, "frictionCoefficient": 0 },
      "as": "stress"
    },
    {
      "command": "set_pipe_operating_conditions",
      "params": {
        "modelId": "$stress",
        "temperatures": [{ "name": "T1", "tempC": 60 }],
        "wallMm": 6.02,
        "material": { "youngsModulusMPa": 200000, "ShMPa": 138, "ScMPa": 138, "thermal": { "meanCtePerK": 0.000012 } }
      }
    },
    { "command": "add_stress_restraint", "params": { "modelId": "$stress", "at": { "pipeId": "$pipe", "atMm": 0 }, "kind": "anchor" } },
    { "command": "add_stress_restraint", "params": { "modelId": "$stress", "at": { "pipeId": "$pipe", "atMm": 6000 }, "kind": "rest" } },
    {
      "command": "set_stress_load_cases",
      "params": {
        "modelId": "$stress",
        "forces": [
          { "name": "F1", "pipeId": "$pipe", "atMm": 3000, "forceN": [0, 0, -1000] },
          { "name": "F2", "pipeId": "$pipe", "atMm": 3000, "forceN": [0, 0, 1000] }
        ],
        "cases": [
          { "name": "DOWN", "type": "SUS", "basic": ["F1"] },
          { "name": "UP", "type": "SUS", "basic": ["F2"] },
          { "name": "WT", "type": "SUS", "basic": ["W"] },
          { "name": "HOT", "type": "OPE", "basic": ["W", "T1"] },
          {
            "name": "RNG",
            "type": "EXP",
            "combine": [
              { "case": "HOT", "factor": 1 },
              { "case": "WT", "factor": -1 }
            ]
          }
        ]
      }
    },
    { "command": "analyze_pipe_stress", "params": { "modelId": "$stress", "include": ["reactions"] } },
    { "command": "check_pipe_stress", "params": { "modelId": "$stress" } },
    { "command": "record_pipe_stress_results", "params": { "modelId": "$stress" } },
    { "command": "approve_pipe_stress", "params": { "modelId": "$stress", "confirmation": true, "at": "2026-11-02T09:30:00Z" } },
    { "command": "move_building_element", "params": { "elementIds": ["$pipe"], "delta": [0, 100] } },
    { "command": "check_pipe_stress", "params": { "modelId": "$stress" } }
  ],
  "expected": [
    {
      "step": 7,
      "path": "data.details.reactions[case=DOWN,nodeId=N3].forceN.2",
      "value": 312.619,
      "rel": 0.001,
      "source": "propped cantilever, load at L/2: R = 5P/16 = 312.5 N (Euler); frame3d Timoshenko 312.619 N"
    },
    {
      "step": 7,
      "path": "data.details.reactions[case=UP,nodeId=N3].forceN.2",
      "value": 0,
      "abs": 0.001,
      "source": "a one-way rest cannot pull (PSI test_plus_y_positive_load)"
    },
    { "step": 7, "path": "data.cases[name=UP].contacts[node=N3].status", "value": "lifted", "source": "TR-PST-05" },
    { "step": 8, "path": "data.items[code=PST_SUPPORT_LIFTOFF].severity", "value": "warn", "source": "TR-PST-11" },
    { "step": 8, "path": "data.items[code=PST_CYCLES_DEFAULTED].severity", "value": "warn", "source": "AF-31" },
    { "step": 8, "path": "data.items[code=PST_INSTALL_TEMP_DEFAULTED].severity", "value": "warn", "source": "AF-31" },
    { "step": 8, "path": "data.items[code=PST_MATERIAL_UNVERIFIED].severity", "value": "warn", "source": "AF-32" },
    { "step": 12, "path": "data.items[code=PST_RESULTS_STALE].severity", "value": "warn", "source": "FR-PST-20" }
  ],
  "refusals": [{ "step": 10, "code": "PST_HUMAN_GATE", "source": "AF-34: an agent cannot approve" }]
}
