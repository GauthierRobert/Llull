{
  "id": "SC-PST-02",
  "validates": ["VC-PST-07", "VC-PST-08"],
  "description": "PSI test_loads fixture in SI: NPS 10 Sch 40 (273.05 x 9.271 mm), anchors at both ends, 3048 mm up, 4572 mm along +y, 15240 mm down, 7620 mm along +y (shifted +12192 mm in z). Thermal 70 -> 900 degF (meanCtePerK 1.4112e-5, 21.111 -> 482.222 degC), weight (density 7833.4 kg/m3, E 192364.4 MPa); node N3 = PSI node 30. The pressure closed forms (VC-PST-09) are checked by the unit tests of the code stress",
  "actions": [
    { "command": "add_level", "params": { "name": "Unit", "elevation": 0 } },
    {
      "command": "add_pipe_run",
      "params": {
        "points": [
          [0, 0, 12192],
          [0, 0, 15240],
          [0, 4572, 15240],
          [0, 4572, 0],
          [0, 12192, 0]
        ],
        "diameter": 273.05,
        "line": "PSI-LOADS"
      },
      "as": "pipe"
    },
    {
      "command": "create_stress_model",
      "params": { "name": "PSI 3D", "pipeIds": ["$pipe"], "rule": "B31.1-2018", "elbowRadiusFactor": 0, "maxElementLengthMm": 100000 },
      "as": "stress"
    },
    {
      "command": "set_pipe_operating_conditions",
      "params": {
        "modelId": "$stress",
        "installTempC": 21.111,
        "temperatures": [{ "name": "T1", "tempC": 482.222 }],
        "fluidDensityKgM3": 0,
        "wallMm": 9.271,
        "material": {
          "youngsModulusMPa": 192364.4,
          "poisson": 0.3,
          "densityKgM3": 7833.4,
          "ShMPa": 82.74,
          "ScMPa": 82.74,
          "thermal": { "meanCtePerK": 1.4112e-5 }
        }
      }
    },
    { "command": "add_stress_restraint", "params": { "modelId": "$stress", "at": { "pipeId": "$pipe", "atMm": 0 }, "kind": "anchor" } },
    { "command": "add_stress_restraint", "params": { "modelId": "$stress", "at": { "pipeId": "$pipe", "atMm": 30480 }, "kind": "anchor" } },
    {
      "command": "set_stress_load_cases",
      "params": {
        "modelId": "$stress",
        "cases": [
          { "name": "TH", "type": "OPE", "basic": ["T1"] },
          { "name": "WT", "type": "SUS", "basic": ["W"] }
        ]
      }
    },
    { "command": "analyze_pipe_stress", "params": { "modelId": "$stress", "nodes": ["N3"], "include": ["displacements"] } }
  ],
  "expected": [
    {
      "step": 7,
      "path": "data.details.displacements[case=TH,node=N3].uMm.1",
      "value": 19.248,
      "rel": 0.01,
      "source": "PSI 0.758 in = frame3d 0.7578 in (data/psi_benchmarks.json)"
    },
    {
      "step": 7,
      "path": "data.details.displacements[case=TH,node=N3].uMm.2",
      "value": 48.034,
      "rel": 0.01,
      "source": "PSI 1.891 in = frame3d 1.8911 in"
    },
    { "step": 7, "path": "data.details.displacements[case=TH,node=N3].rotDeg.0", "value": 0.1521, "rel": 0.01, "source": "PSI / frame3d" },
    {
      "step": 7,
      "path": "data.details.displacements[case=WT,node=N3].uMm.2",
      "value": -33.15,
      "rel": 0.03,
      "source": "PSI -1.31 in, frame3d -1.3051 in"
    }
  ],
  "notes": "The Sh value (82.74 MPa, 12 000 psi) is the PSI B31.1 A53A figure, used only so the model is complete; no gate depends on it. The elbows are sharp corners because the PSI fixture has no bends."
}
