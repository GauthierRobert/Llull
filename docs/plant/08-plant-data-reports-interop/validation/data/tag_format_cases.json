{
 "source": "closed form: the format grammar of TECHNICAL_SPEC \u00a75.2 (DAT); formats are examples modelled on the Size-Spec-Service-Line Number default of AutoCAD P&ID/Plant 3D [S5] and area-type-number equipment tags; not an industry standard",
 "formats": {
  "equipment": {
   "format": "{classCode}-{area}{seq:2}",
   "fields": {
    "classCode": {
     "type": "enum",
     "values": [
      "C",
      "E",
      "P",
      "T",
      "V"
     ]
    },
    "area": {
     "type": "digits",
     "length": 1
    },
    "seq": {
     "type": "integer",
     "pad": 2,
     "min": 1
    }
   },
   "regex": "^(C|E|P|T|V)-[0-9][0-9]{2}$"
  },
  "line": {
   "format": "{nominalSize}-{fluidCode}-{seq:4}-{spec}",
   "fields": {
    "nominalSize": {
     "type": "integer",
     "min": 6
    },
    "fluidCode": {
     "type": "pattern",
     "pattern": "[A-Z]{1,3}"
    },
    "seq": {
     "type": "integer",
     "pad": 4,
     "min": 1
    },
    "spec": {
     "type": "pattern",
     "pattern": "[A-Z0-9]{2,6}"
    }
   },
   "regex": "^[0-9]+-[A-Z]{1,3}-[0-9]{4}-[A-Z0-9]{2,6}$"
  },
  "valve": {
   "format": "{valveCode}-{seq:4}",
   "fields": {
    "valveCode": {
     "type": "pattern",
     "pattern": "[A-Z]{1,4}"
    },
    "seq": {
     "type": "integer",
     "pad": 4,
     "min": 1
    }
   },
   "regex": "^[A-Z]{1,4}-[0-9]{4}$"
  }
 },
