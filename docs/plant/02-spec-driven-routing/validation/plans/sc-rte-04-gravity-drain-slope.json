{
  "id": "SC-RTE-04",
  "status": "RUNNABLE (02 RTE M3): sloped legs (planLength + slope, section 5.6), the standard elbow at the real turn angle, the tolerance refusal, and the adverse-slope / pocket checks. Case a runs the route, check_piping and piping_takeoff; case b is the refusal; case c the checks (each case is its own plan, a refused step stops build_project).",
  "unbuilt": [],
  "harness": {
    "inline": { "prefix[0].params.catalog": "../data/catalog_stub_cs150.json", "prefix[1].params.spec": "../data/spec_cs150.json" },
    "note": "the test harness (and the CLI --param-file) inlines the fixtures before the run: catalog_stub_cs150.json = the input dimensions of these plans (catalogue rte-validation-stub), spec_cs150.json = spec CS150 in the 01 PSC llull-pipe-spec format"
  },
  "validates": ["VC-RTE-08", "VC-RTE-27"],
  "description": "DN50 gravity drain from TP-D1 at (0,0,1000) running +X 8000 mm (plan length) at a 1 % fall, then down to a drain hub TP-D2 at grade (z 0). The elbow sees a 89.427 deg turn: inside the spec tolerance of 1 deg it is a standard 90 LR elbow. The same route with angleToleranceDeg 0.5 is refused. A second line shows the checks: a rise against the declared fall (RTE_ADVERSE_SLOPE) and a low point without a drain (RTE_POCKET).",
  "units": "mm",
  "prefix": [
    { "command": "import_piping_catalog", "params": { "catalog": "<data/catalog_stub_cs150.json>" } },
    { "command": "import_pipe_spec", "params": { "spec": "<data/spec_cs150.json>" } },
    {
      "command": "add_tie_in_point",
      "params": { "tag": "TP-D1", "position": [0, 0, 1000], "direction": [1, 0, 0], "dn": 50, "endType": "BW" },
      "as": "d1"
    },
    {
      "command": "add_tie_in_point",
      "params": { "tag": "TP-D2", "position": [8000, 0, 0], "direction": [0, 0, 1], "dn": 50, "endType": "BW" },
      "as": "d2"
    },
    { "command": "create_pipeline", "params": { "service": "D", "sequence": "3001", "spec": "CS150", "dn": 50 }, "as": "line" }
  ],
  "cases": [
    {
      "id": "SC-RTE-04a",
      "what": "1 % fall over 8000 mm plan length, then down to the hub: drop 80, standard 90 LR elbow at 89.427 deg, no adverse slope, cuts 7924.39999 / 844",
      "actions": [
        {
          "command": "route_pipe",
          "params": {
            "lineId": "$line",
            "from": { "portId": "$d1" },
            "to": { "portId": "$d2" },
            "legs": [{ "direction": "+X", "planLength": 8000, "slope": { "value": 1, "unit": "percent", "fall": true } }]
          },
          "as": "run"
        },
        { "command": "check_piping", "params": { "lineIds": ["$line"] } },
        { "command": "piping_takeoff", "params": { "runId": "$run" } }
      ],
      "expected": [
        { "step": 0, "path": "data.legs[0].dropMm", "value": 80, "abs": 0.000001, "source": "8000 x 0.01" },
        { "step": 0, "path": "data.legs[0].planLengthMm", "value": 8000, "abs": 0.000001, "source": "given" },
        { "step": 0, "path": "data.legs[0].lengthMm", "value": 8000.39999, "abs": 0.0001, "source": "sqrt(8000^2 + 80^2)" },
        { "step": 0, "path": "data.legs[0].slopeDeg", "value": 0.572939, "abs": 0.000001, "source": "atan(0.01)" },
        { "step": 0, "path": "data.legs[1].lengthMm", "value": 920, "abs": 0.000001, "source": "closing leg: 1000 - 80" },
        { "step": 0, "path": "data.turns[0].turnDeg", "value": 89.427061, "abs": 0.000001, "source": "acos(80 / 8000.4)" },
        { "step": 0, "path": "data.turns[0].fitting", "value": "elbow90LR" },
        { "step": 0, "path": "data.turns[0].deviationDeg", "value": 0.572939, "abs": 0.000001, "source": "90 - 89.427061" },
        {
          "step": 0,
          "path": "data.portDeviationDeg.start",
          "value": 0.572939,
          "abs": 0.000001,
          "source": "the sloped first leg leaves the port by atan(0.01)"
        },
        {
          "step": 1,
          "path": "data.issues[?code!='RTE_SPEC_UNVERIFIED'].length",
          "value": 0,
          "source": "fall is downstream, no adverse slope, no pocket; both ends on tie-ins"
        },
        {
          "step": 2,
          "path": "data.pipePieces[*].cutLengthMm",
          "value": [7924.39999, 844],
          "abs": 0.001,
          "source": "8000.4 - 76 ; (1000 - 80) - 76"
        }
      ]
    },
    {
      "id": "SC-RTE-04b",
      "what": "the same route with angleToleranceDeg 0.5 is refused at the elbow: 0.573 deg deviation > 0.5 deg",
      "actions": [
        {
          "command": "route_pipe",
          "params": {
            "lineId": "$line",
            "from": { "portId": "$d1" },
            "to": { "portId": "$d2" },
            "angleToleranceDeg": 0.5,
            "legs": [{ "direction": "+X", "planLength": 8000, "slope": { "value": 1, "unit": "percent", "fall": true } }]
          }
        }
      ],
      "expected": [
        { "path": "error.code", "value": "RTE_NO_FITTING_FOR_ANGLE" },
        { "path": "error.detail.angleDeg", "value": 89.427061, "abs": 0.000001 }
      ]
    },
    {
      "id": "SC-RTE-04c",
      "what": "a line declared 1 % fall whose profile falls, runs flat and then rises reports the rising leg and the low point without a drain",
      "actions": [
        {
          "command": "create_pipeline",
          "params": {
            "service": "D",
            "sequence": "3002",
            "spec": "CS150",
            "dn": 50,
            "slope": { "value": 1, "unit": "percent", "fall": true }
          },
          "as": "gravity"
        },
        {
          "command": "route_pipe",
          "params": {
            "lineId": "$gravity",
            "from": { "portId": "$d1" },
            "legs": [
              { "direction": "+X", "planLength": 4000, "slope": { "value": 1, "unit": "percent", "fall": true } },
              { "direction": "-Z", "length": 500 },
              { "direction": "+X", "length": 1000 },
              { "direction": "+Z", "length": 600 }
            ]
          }
        },
        { "command": "check_piping", "params": { "lineIds": ["$gravity"] } }
      ],
      "expected": [
        {
          "step": 2,
          "path": "data.issues[?code=='RTE_ADVERSE_SLOPE'].length",
          "value": 1,
          "source": "only the +Z leg (leg 3) rises along the flow; the flat +X leg is not adverse"
        },
        {
          "step": 2,
          "path": "data.issues[?code=='RTE_POCKET'].length",
          "value": 1,
          "source": "the profile falls (legs 0, 1), runs flat, then rises (leg 3): one low point, no drain"
        },
        { "step": 2, "path": "data.issues[?code=='RTE_POCKET'][0].detail.kind", "value": "low" },
        { "step": 2, "path": "data.status", "value": "warn" }
      ]
    }
  ]
}
