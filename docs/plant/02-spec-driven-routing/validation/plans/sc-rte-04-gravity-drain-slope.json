    { "step": 4, "path": "data.status", "value": "pass", "source": "fall is downstream, no adverse slope, no pocket" },
    { "step": 5, "path": "data.pipePieces[*].cutLengthMm", "value": [7924.39999, 844], "abs": 1e-3, "source": "8000.4 - 76 ; (1000 - 80) - 76" },
