  "units": "mm",
  "actions": [
    { "command": "add_tie_in_point", "params": { "tag": "TP-D1", "position": [0, 0, 1000], "direction": [1, 0, 0], "dn": 50, "endType": "BW" }, "as": "d1" },
    { "command": "add_tie_in_point", "params": { "tag": "TP-D2", "position": [8000, 0, 0], "direction": [0, 0, 1], "dn": 50, "endType": "BW" }, "as": "d2" },
    { "command": "create_pipeline", "params": { "service": "D", "sequence": "3001", "spec": "CS150", "dn": 50, "slope": { "value": 1, "unit": "percent" } }, "as": "line" },
    { "command": "route_pipe", "params": { "lineId": "$line", "from": { "portId": "$d1" }, "to": { "portId": "$d2" }, "legs": [ { "direction": "+X", "planLength": 8000, "slope": { "value": 1, "unit": "percent", "fall": true } } ] }, "as": "run" },
    { "command": "check_piping", "params": { "lineIds": ["$line"] } },
    { "command": "piping_takeoff", "params": { "runId": "$run" } },
    { "command": "route_pipe", "params": { "lineId": "$line", "from": { "portId": "$d1" }, "to": { "portId": "$d2" }, "angleToleranceDeg": 0.5, "legs": [ { "direction": "+X", "planLength": 8000, "slope": { "value": 1, "unit": "percent", "fall": true } } ] }, "expectError": "RTE_NO_FITTING_FOR_ANGLE", "note": "last step: build_project stops here and reports the step error (AF-14)" }
  ],
  "expected": [
    { "step": 3, "path": "data.legs[0].dropMm", "value": 80, "abs": 1e-6, "source": "8000 x 0.01" },
    { "step": 3, "path": "data.legs[0].lengthMm", "value": 8000.39999, "abs": 1e-4, "source": "sqrt(8000^2 + 80^2)" },
    { "step": 3, "path": "data.legs[0].slopeDeg", "value": 0.572939, "abs": 1e-6, "source": "atan(0.01)" },
    { "step": 3, "path": "data.turns[0].angleDeg", "value": 89.427061, "abs": 1e-6, "source": "acos(80 / 8000.4)" },
