{
  "id": "SC-RTE-03",
  "status": "RUNNABLE (02 RTE M2): every step runs (add_branch with the spec branch table, piping_connectivity, check_piping, piping_takeoff of the line).",
  "unbuilt": [],
  "harness": {
    "inline": { "actions[0].params.catalog": "../data/catalog_stub_cs150.json", "actions[1].params.spec": "../data/spec_cs150.json" },
    "note": "the test harness (and the CLI --param-file) inlines the fixtures before the run: catalog_stub_cs150.json = the input dimensions of these plans (catalogue rte-validation-stub), spec_cs150.json = spec CS150 in the 01 PSC llull-pipe-spec format"
  },
  "validates": ["VC-RTE-06", "VC-RTE-07"],
  "description": "DN150 header between two butt-weld tie-in points (x 0 and x 10000, z 3000). A DN100 branch at x 4000 going +Y 2000 to tie-in TP-3, and a DN50 branch at x 7000 going +Z 1000 left open on purpose. The spec branch table must pick a reducing tee 6x4 and a weldolet 6x2 (stub catalogue inputs: tee C 143 / M 130, weldolet outlet 144 mm from the header centreline).",
  "units": "mm",
  "actions": [
    { "command": "import_piping_catalog", "params": { "catalog": "<data/catalog_stub_cs150.json>" } },
    { "command": "import_pipe_spec", "params": { "spec": "<data/spec_cs150.json>" } },
    {
      "command": "add_tie_in_point",
      "params": { "tag": "TP-1", "position": [0, 0, 3000], "direction": [1, 0, 0], "dn": 150, "endType": "BW" },
      "as": "tp1"
    },
    {
      "command": "add_tie_in_point",
      "params": { "tag": "TP-2", "position": [10000, 0, 3000], "direction": [-1, 0, 0], "dn": 150, "endType": "BW" },
      "as": "tp2"
    },
    {
      "command": "add_tie_in_point",
      "params": { "tag": "TP-3", "position": [4000, 2000, 3000], "direction": [0, -1, 0], "dn": 100, "endType": "BW" },
      "as": "tp3"
    },
    { "command": "create_pipeline", "params": { "service": "CW", "sequence": "2001", "spec": "CS150", "dn": 150 }, "as": "line" },
    { "command": "route_pipe", "params": { "lineId": "$line", "from": { "portId": "$tp1" }, "to": { "portId": "$tp2" } }, "as": "header" },
    {
      "command": "add_branch",
      "params": { "runId": "$header", "at": { "point": [4000, 0, 3000] }, "dn": 100, "to": { "portId": "$tp3" } },
      "as": "branch4"
    },
    {
      "command": "add_branch",
      "params": { "runId": "$header", "at": { "point": [7000, 0, 3000] }, "dn": 50, "legs": [{ "direction": "+Z", "length": 1000 }] },
      "as": "branch2"
    },
    { "command": "piping_connectivity", "params": { "lineIds": ["$line"] } },
    { "command": "check_piping", "params": { "lineIds": ["$line"] } },
    { "command": "piping_takeoff", "params": { "lineId": "$line" } }
  ],
  "expected": [
    { "step": 7, "path": "data.branchStartMm", "value": 130, "abs": 0.01, "source": "reducing tee outlet M = 130" },
    { "step": 8, "path": "data.branchStartMm", "value": 144, "abs": 0.01, "source": "weldolet outlet A = 144" },
    { "step": 7, "path": "data.fitting", "value": "reducingTee", "source": "branch table (6,4); PSC component type name" },
    { "step": 8, "path": "data.fitting", "value": "weldolet", "source": "branch table (6,2)" },
    { "step": 9, "path": "data.openEnds.length", "value": 1, "source": "only the DN50 branch end is free" },
    { "step": 10, "path": "data.issues[?code=='RTE_OPEN_END'].length", "value": 1 },
    { "step": 10, "path": "data.status", "value": "warn" },
    {
      "step": 11,
      "path": "data.counts",
      "value": { "reducingTee": 1, "weldolet": 1, "pipePieces": 4 },
      "source": "header cut by the tee only; the olet does not cut the header"
    },
    {
      "step": 11,
      "path": "data.pipePieces[?dn==150].cutLengthMm",
      "value": [3857, 5857],
      "abs": 0.01,
      "source": "4000 - 143 ; 6000 - 143 (C = 143)"
    },
    { "step": 11, "path": "data.pipePieces[?dn==100].cutLengthMm", "value": [1870], "abs": 0.01, "source": "2000 - 130 (M = 130)" },
    {
      "step": 11,
      "path": "data.pipePieces[?dn==50].cutLengthMm",
      "value": [856],
      "abs": 0.01,
      "source": "1000 - 144 (weldolet outlet face 144 mm from the header centreline, a declared stub input of catalog_stub_cs150.json)"
    }
  ]
}
