{
  "id": "SC-RTE-05",
  "status": "PROPOSED - not runnable yet. Unbuilt: load_pipe_spec (01), add_nozzle (03), add_tie_in_point, create_pipeline, route_pipe, check_piping. Each case is its own plan (a refused step stops build_project); the driver runs them one by one.",
  "unbuilt": ["load_pipe_spec", "add_nozzle", "add_tie_in_point", "create_pipeline", "route_pipe", "check_piping"],
  "validates": ["VC-RTE-09", "VC-RTE-10", "VC-RTE-11"],
  "units": "mm",
  "prefix": [
    { "command": "add_tie_in_point", "params": { "tag": "TP-A", "position": [0, 0, 2000], "direction": [1, 0, 0], "dn": 100, "endType": "BW" }, "as": "a" },
    { "command": "create_pipeline", "params": { "service": "P", "sequence": "5001", "spec": "CS150", "dn": 100 }, "as": "line" }
  ],
  "cases": [
    {
      "id": "SC-RTE-05a", "what": "two NPS 4 LR elbows 250 mm apart (needs 2 x 152 = 304)",
      "actions": [ { "command": "route_pipe", "params": { "lineId": "$line", "from": { "portId": "$a" }, "legs": [ { "direction": "+X", "length": 1000 }, { "direction": "+Y", "length": 250 }, { "direction": "+X", "length": 1000 } ] } } ],
      "expected": [ { "path": "error.code", "value": "RTE_SEGMENT_TOO_SHORT" }, { "path": "error.paths", "value": ["legs.1"] }, { "path": "error.detail.cutLengthMm", "value": -54, "abs": 0.01 } ]
    },
    {
      "id": "SC-RTE-05b", "what": "exactly 304 mm: fitting-to-fitting (cut 0) is accepted with a warning",
      "actions": [
        { "command": "route_pipe", "params": { "lineId": "$line", "from": { "portId": "$a" }, "legs": [ { "direction": "+X", "length": 1000 }, { "direction": "+Y", "length": 304 }, { "direction": "+X", "length": 1000 } ] }, "as": "run" },
        { "command": "check_piping", "params": { "lineIds": ["$line"] } }
      ],
      "expected": [ { "step": 1, "path": "data.issues[?code=='RTE_FITTING_TO_FITTING'].length", "value": 1 }, { "step": 1, "path": "data.issues[?code=='RTE_OPEN_END'].length", "value": 1 } ]
    },
    {
      "id": "SC-RTE-05c", "what": "340 mm: a 36 mm pipe piece is shorter than the named default weld spacing max(4 t, 50 mm) = 50 mm",
      "actions": [
        { "command": "route_pipe", "params": { "lineId": "$line", "from": { "portId": "$a" }, "legs": [ { "direction": "+X", "length": 1000 }, { "direction": "+Y", "length": 340 }, { "direction": "+X", "length": 1000 } ] } },
        { "command": "check_piping", "params": { "lineIds": ["$line"] } }
      ],
      "expected": [ { "step": 1, "path": "data.issues[?code=='RTE_WELD_SPACING'][0].detail", "value": { "cutLengthMm": 36, "minWeldSpacingMm": 50, "source": "project default (BS 2633 4t / common 50 mm), defaulted: true" }, "abs": 0.01 } ]
    },
    {
      "id": "SC-RTE-05d", "what": "60 deg turn with a spec that has 90 / 45 elbows only",
      "actions": [ { "command": "route_pipe", "params": { "lineId": "$line", "from": { "portId": "$a" }, "legs": [ { "direction": "+X", "length": 1000 }, { "direction": [0.5, 0.8660254, 0], "length": 1000 } ] } } ],
      "expected": [ { "path": "error.code", "value": "RTE_NO_FITTING_FOR_ANGLE" }, { "path": "error.detail.angleDeg", "value": 60, "abs": 1e-4 } ]
    },
    {
      "id": "SC-RTE-05e", "what": "DN100 line ends on a DN80 nozzle; the spec has no 4x3 reducer",
      "actions": [
        { "command": "add_equipment", "params": { "name": "Tank", "mark": "T-1", "location": [3000, 0], "size": [1000, 1000, 3000], "shape": "vertical_vessel" }, "as": "tank" },
        { "command": "add_nozzle", "params": { "equipmentId": "$tank", "tag": "N1", "position": [2400, 0, 2000], "direction": [-1, 0, 0], "dn": 80, "rating": "CL150", "facing": "RF", "endType": "FL" }, "as": "n80" },
        { "command": "route_pipe", "params": { "lineId": "$line", "from": { "portId": "$a" }, "to": { "portId": "$n80" } } }
      ],
      "expected": [ { "step": 2, "path": "error.code", "value": "RTE_SIZE_MISMATCH" }, { "step": 2, "path": "error.remediation", "contains": "reducer" } ]
    },
    {
      "id": "SC-RTE-05f", "what": "CL300 nozzle on a CL150 spec line",
      "actions": [
        { "command": "add_equipment", "params": { "name": "Tank", "mark": "T-2", "location": [3000, 0], "size": [1000, 1000, 3000], "shape": "vertical_vessel" }, "as": "tank" },
        { "command": "add_nozzle", "params": { "equipmentId": "$tank", "tag": "N1", "position": [2400, 0, 2000], "direction": [-1, 0, 0], "dn": 100, "rating": "CL300", "facing": "RF", "endType": "FL" }, "as": "n300" },
        { "command": "route_pipe", "params": { "lineId": "$line", "from": { "portId": "$a" }, "to": { "portId": "$n300" } } }
      ],
      "expected": [ { "step": 2, "path": "error.code", "value": "RTE_RATING_MISMATCH" } ]
    },
    {
      "id": "SC-RTE-05g", "what": "socket-weld nozzle end on a spec without a BW-SW connection rule",
      "actions": [
        { "command": "add_equipment", "params": { "name": "Skid", "mark": "S-1", "location": [3000, 0], "size": [1000, 1000, 3000] }, "as": "skid" },
        { "command": "add_nozzle", "params": { "equipmentId": "$skid", "tag": "N1", "position": [2400, 0, 2000], "direction": [-1, 0, 0], "dn": 100, "rating": "CL150", "endType": "SW" }, "as": "nsw" },
        { "command": "route_pipe", "params": { "lineId": "$line", "from": { "portId": "$a" }, "to": { "portId": "$nsw" } } }
      ],
      "expected": [ { "step": 2, "path": "error.code", "value": "RTE_NO_CONNECTION_RULE" } ]
    }
  ]
}
