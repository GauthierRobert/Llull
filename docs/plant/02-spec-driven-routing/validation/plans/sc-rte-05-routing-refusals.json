{
  "id": "SC-RTE-05",
  "status": "PARTLY RUNNABLE (02 RTE M1): cases a, d, e, f, g run; b and c run their step 0 (route_pipe); their check_piping step 1 is 02 M2. Each case is its own plan (a refused step stops build_project); the driver runs prefix + case one by one.",
  "unbuilt": ["check_piping"],
  "validates": ["VC-RTE-09", "VC-RTE-10", "VC-RTE-11"],
  "units": "mm",
  "prefix": [
    { "command": "import_piping_catalog", "params": { "catalog": "<data/catalog_stub_cs150.json>" } },
    { "command": "import_pipe_spec", "params": { "spec": "<data/spec_cs150.json>" } },
    {
      "command": "add_tie_in_point",
      "params": { "tag": "TP-A", "position": [0, 0, 2000], "direction": [1, 0, 0], "dn": 100, "endType": "BW" },
      "as": "a"
    },
    { "command": "create_pipeline", "params": { "service": "P", "sequence": "5001", "spec": "CS150", "dn": 100 }, "as": "line" }
  ],
  "cases": [
    {
      "id": "SC-RTE-05a",
      "what": "two NPS 4 LR elbows 250 mm apart (needs 2 x 152 = 304)",
      "actions": [
        {
          "command": "route_pipe",
          "params": {
            "lineId": "$line",
            "from": { "portId": "$a" },
            "legs": [
              { "direction": "+X", "length": 1000 },
              { "direction": "+Y", "length": 250 },
              { "direction": "+X", "length": 1000 }
            ]
          }
        }
      ],
      "expected": [
        { "path": "error.code", "value": "RTE_SEGMENT_TOO_SHORT" },
        { "path": "error.paths", "value": ["legs.1"] },
        { "path": "error.detail.cutLengthMm", "value": -54, "abs": 0.01 }
      ]
    },
    {
      "id": "SC-RTE-05b",
      "what": "exactly 304 mm: fitting-to-fitting (cut 0) is accepted with a warning",
      "actions": [
        {
          "command": "route_pipe",
          "params": {
            "lineId": "$line",
            "from": { "portId": "$a" },
            "legs": [
              { "direction": "+X", "length": 1000 },
              { "direction": "+Y", "length": 304 },
              { "direction": "+X", "length": 1000 }
            ]
          },
          "as": "run"
        },
        { "command": "check_piping", "params": { "lineIds": ["$line"] } }
      ],
      "expected": [
        { "step": 1, "path": "data.issues[?code=='RTE_FITTING_TO_FITTING'].length", "value": 1 },
        { "step": 1, "path": "data.issues[?code=='RTE_OPEN_END'].length", "value": 1 }
      ]
    },
    {
      "id": "SC-RTE-05c",
      "what": "340 mm: a 36 mm pipe piece is shorter than the named default weld spacing max(4 t, 50 mm) = 50 mm",
      "actions": [
        {
          "command": "route_pipe",
          "params": {
            "lineId": "$line",
            "from": { "portId": "$a" },
            "legs": [
              { "direction": "+X", "length": 1000 },
              { "direction": "+Y", "length": 340 },
              { "direction": "+X", "length": 1000 }
            ]
          }
        },
        { "command": "check_piping", "params": { "lineIds": ["$line"] } }
      ],
      "expected": [
        {
          "step": 1,
          "path": "data.issues[?code=='RTE_WELD_SPACING'][0].detail",
          "value": { "cutLengthMm": 36, "minWeldSpacingMm": 50, "source": "project default (BS 2633 4t / common 50 mm), defaulted: true" },
          "abs": 0.01
        }
      ]
    },
    {
      "id": "SC-RTE-05d",
      "what": "60 deg turn with a spec that has 90 / 45 elbows only",
      "actions": [
        {
          "command": "route_pipe",
          "params": {
            "lineId": "$line",
            "from": { "portId": "$a" },
            "legs": [
              { "direction": "+X", "length": 1000 },
              { "direction": [0.5, 0.8660254, 0], "length": 1000 }
            ]
          }
        }
      ],
      "expected": [
        { "path": "error.code", "value": "RTE_NO_FITTING_FOR_ANGLE" },
        { "path": "error.detail.angleDeg", "value": 60, "abs": 0.0001 }
      ]
    },
    {
      "id": "SC-RTE-05e",
      "what": "DN100 line ends on a DN80 nozzle; the spec has no 4x3 reducer",
      "actions": [
        {
          "command": "add_equipment",
          "params": { "name": "Tank", "mark": "T-1", "location": [3000, 0], "size": [1000, 1000, 3000], "shape": "vertical_vessel" },
          "as": "tank"
        },
        {
          "command": "add_nozzle",
          "params": {
            "equipment": "T-1",
            "mark": "N1",
            "dn": 80,
            "rating": "CL150",
            "facing": "RF",
            "location": { "on": "free", "position": [-600, 0, 2000], "direction": [-1, 0, 0] },
            "projection": 300
          },
          "as": "nozzle",
          "note": "world face centre (2400, 0, 2000) facing -X; port T-1:N1"
        },
        { "command": "route_pipe", "params": { "lineId": "$line", "from": { "portId": "$a" }, "to": { "portId": "T-1:N1" } } }
      ],
      "expected": [
        { "step": 2, "path": "error.code", "value": "RTE_SIZE_MISMATCH" },
        { "step": 2, "path": "error.remediation", "contains": "reducer" }
      ]
    },
    {
      "id": "SC-RTE-05f",
      "what": "CL300 nozzle on a CL150 spec line",
      "actions": [
        {
          "command": "add_equipment",
          "params": { "name": "Tank", "mark": "T-2", "location": [3000, 0], "size": [1000, 1000, 3000], "shape": "vertical_vessel" },
          "as": "tank"
        },
        {
          "command": "add_nozzle",
          "params": {
            "equipment": "T-2",
            "mark": "N1",
            "dn": 100,
            "rating": "CL300",
            "facing": "RF",
            "location": { "on": "free", "position": [-600, 0, 2000], "direction": [-1, 0, 0] },
            "projection": 300
          },
          "as": "nozzle",
          "note": "world face centre (2400, 0, 2000) facing -X; port T-2:N1"
        },
        { "command": "route_pipe", "params": { "lineId": "$line", "from": { "portId": "$a" }, "to": { "portId": "T-2:N1" } } }
      ],
      "expected": [{ "step": 2, "path": "error.code", "value": "RTE_RATING_MISMATCH" }]
    },
    {
      "id": "SC-RTE-05g",
      "what": "a socket-weld port (SW end) on a spec without a BW-SW connection rule; nozzles are always flanged (add_nozzle), so the SW end is a tie-in point",
      "actions": [
        {
          "command": "add_tie_in_point",
          "params": { "tag": "SW-1", "position": [2400, 0, 2000], "direction": [-1, 0, 0], "dn": 100, "endType": "SW" },
          "as": "nsw"
        },
        { "command": "route_pipe", "params": { "lineId": "$line", "from": { "portId": "$a" }, "to": { "portId": "$nsw" } } }
      ],
      "expected": [{ "step": 1, "path": "error.code", "value": "RTE_NO_CONNECTION_RULE" }]
    }
  ],
  "nozzleNote": "add_nozzle (03 EQP, built) takes a free { position, direction } location in the equipment frame for pumps and plain add_equipment blocks (README D3) or a shell / head location for vessels; the port id is '<tag>:<mark>' (here P-101:N2 and V-101:N1). route_pipe takes that port id in { portId }.",
  "harness": {
    "inline": { "prefix[0].params.catalog": "../data/catalog_stub_cs150.json", "prefix[1].params.spec": "../data/spec_cs150.json" },
    "note": "the test harness (and the CLI --param-file) inlines the fixtures before the run: catalog_stub_cs150.json = the input dimensions of these plans (catalogue rte-validation-stub), spec_cs150.json = spec CS150 in the 01 PSC llull-pipe-spec format"
  }
}
