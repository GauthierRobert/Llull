{
  "id": "SC-RTE-12",
  "status": "RUNNABLE (02 RTE V1 part 1): every case runs.",
  "unbuilt": [],
  "validates": ["VC-RTE-33"],
  "description": "A DN150 line from a butt-weld tie-in at the origin facing +X: +X 4000 then a riser +Z 1000, an eccentric reducer 6x4 (H 140, a declared stub input) centred at 2000 on the first leg. Flat on top (FOT) puts the DN100 axis e = (168.3 - 114.3) / 2 = 27 mm higher, so the elbow centre rises by 27 and the riser starts 27 higher (it is shorter by that); flat on bottom (FOB) puts the axis 27 lower and the riser starts 27 lower. A reducer + expander pair on one leg cancels. A reducer whose offset the next leg cannot take (a turn along +Y after a flat on top) is refused with RTE_ECCENTRIC_OFFSET.",
  "units": "mm",
  "harness": {
    "inline": { "prefix[0].params.catalog": "../data/catalog_stub_cs150.json", "prefix[1].params.spec": "../data/spec_cs150.json" },
    "note": "the test harness (and the CLI --param-file) inlines the fixtures before the run: catalog_stub_cs150.json = the input dimensions of these plans (catalogue rte-validation-stub, with the eccentric reducer rows), spec_cs150.json = spec CS150 in the 01 PSC llull-pipe-spec format"
  },
  "prefix": [
    { "command": "import_piping_catalog", "params": { "catalog": "<data/catalog_stub_cs150.json>" } },
    { "command": "import_pipe_spec", "params": { "spec": "<data/spec_cs150.json>" } },
    {
      "command": "add_tie_in_point",
      "params": { "tag": "EA", "position": [0, 0, 0], "direction": [1, 0, 0], "dn": 150, "endType": "BW" },
      "as": "ea"
    },
    { "command": "create_pipeline", "params": { "service": "P", "sequence": "5003", "spec": "CS150", "dn": 150 }, "as": "line" }
  ],
  "cases": [
    {
      "id": "flat-on-top",
      "actions": [
        {
          "command": "route_pipe",
          "params": {
            "lineId": "$line",
            "from": { "portId": "$ea" },
            "legs": [
              { "direction": "+X", "length": 4000 },
              { "direction": "+Z", "length": 1000 }
            ],
            "inline": [{ "type": "reducerEccentric", "tag": "RE-1", "dn2": 100, "flat": "top", "at": { "leg": 0, "centreDistance": 2000 } }]
          },
          "as": "run"
        },
        { "command": "piping_takeoff", "params": { "runId": "$run" } },
        { "command": "check_piping", "params": { "lineIds": ["$line"] } }
      ],
      "expected": [
        {
          "step": 0,
          "path": "data.pipePieces[*].cutLengthMm",
          "value": [1930, 1778, 821],
          "abs": 0.01,
          "source": "DN150 from the port to the reducer face 2000 - 70 = 1930 ; DN100 from 2070 to the elbow (4000 - 152 = 3848) = 1778 ; the riser starts at z 27 (elbow centre) : 1000 - (27 + 152) = 821"
        },
        {
          "step": 0,
          "path": "data.legs[*].lengthMm",
          "value": [4000, 973],
          "abs": 0.01,
          "source": "the riser is 27 shorter: it starts 27 higher"
        },
        {
          "step": 0,
          "path": "data.centrelineLengthMm",
          "value": 4907.761,
          "abs": 0.001,
          "source": "(4000 + 973) - 2 x 152 + 152 x pi / 2"
        },
        { "step": 0, "path": "data.counts.reducerEccentric", "value": 1 },
        { "step": 1, "path": "data.inline[0].flat.label", "value": "top" },
        { "step": 1, "path": "data.inline[0].flat.offsetMm", "value": 27, "abs": 0.000001, "source": "(168.3 - 114.3) / 2" },
        {
          "step": 1,
          "path": "data.inline[0].flat.invertStepMm",
          "value": 54,
          "abs": 0.000001,
          "source": "the bottom of the DN100 pipe is 27 (axis) + 27 (radius difference) = 54 higher than the bottom of the DN150 pipe"
        },
        { "step": 1, "path": "data.legs[0].end", "value": [4000, 0, 27], "abs": 0.000001, "source": "the corner moves with the offset" },
        { "step": 2, "path": "data.issues[?code=='RTE_OPEN_END'].length", "value": 1 }
      ]
    },
    {
      "id": "flat-on-bottom",
      "actions": [
        {
          "command": "route_pipe",
          "params": {
            "lineId": "$line",
            "from": { "portId": "$ea" },
            "legs": [
              { "direction": "+X", "length": 4000 },
              { "direction": "+Z", "length": 1000 }
            ],
            "inline": [
              { "type": "reducerEccentric", "tag": "RE-1", "dn2": 100, "flat": "bottom", "at": { "leg": 0, "centreDistance": 2000 } }
            ]
          },
          "as": "run"
        },
        { "command": "piping_takeoff", "params": { "runId": "$run" } }
      ],
      "expected": [
        {
          "step": 0,
          "path": "data.pipePieces[*].cutLengthMm",
          "value": [1930, 1778, 875],
          "abs": 0.01,
          "source": "the DN100 axis is 27 lower (bottoms line up: -27 - 57.15 = -84.15 = -168.3 / 2) ; the riser starts at z -27 : 1000 - (-27 + 152) = 875"
        },
        { "step": 0, "path": "data.legs[*].lengthMm", "value": [4000, 1027], "abs": 0.01 },
        {
          "step": 1,
          "path": "data.inline[0].flat.invertStepMm",
          "value": 0,
          "abs": 0.000001,
          "source": "flat on bottom keeps the bottoms flush: -27 + 27"
        }
      ]
    },
    {
      "id": "reducer-and-expander-cancel",
      "actions": [
        {
          "command": "route_pipe",
          "params": {
            "lineId": "$line",
            "from": { "portId": "$ea" },
            "legs": [{ "direction": "+X", "length": 5000 }],
            "inline": [
              { "type": "reducerEccentric", "tag": "RE-1", "dn2": 100, "flat": "bottom", "at": { "leg": 0, "centreDistance": 1000 } },
              { "type": "reducerEccentric", "tag": "RE-2", "dn2": 150, "flat": "bottom", "at": { "leg": 0, "centreDistance": 3000 } }
            ]
          }
        }
      ],
      "expected": [
        {
          "step": 0,
          "path": "data.pipePieces[*].cutLengthMm",
          "value": [930, 1860, 1930],
          "abs": 0.01,
          "source": "DN150 0 - 930 ; DN100 from 1070 to 2930 ; DN150 from 3070 to 5000 : the expander puts the axis back (+27 after -27)"
        }
      ]
    },
    {
      "id": "offset-not-taken-up",
      "actions": [
        {
          "command": "route_pipe",
          "params": {
            "lineId": "$line",
            "from": { "portId": "$ea" },
            "legs": [
              { "direction": "+X", "length": 4000 },
              { "direction": "+Y", "length": 1000 }
            ],
            "inline": [{ "type": "reducerEccentric", "tag": "RE-1", "dn2": 100, "flat": "top", "at": { "leg": 0, "centreDistance": 2000 } }]
          }
        }
      ],
      "expected": [
        { "step": 0, "path": "error.code", "value": "RTE_ECCENTRIC_OFFSET" },
        { "step": 0, "path": "error.detail.angleDeg", "value": 90, "abs": 0.000001 }
      ]
    }
  ]
}
