{
  "id": "SC-RTE-01",
  "status": "RUNNABLE (02 RTE M2): every step runs, including step 8 check_piping (RTE_SPEC_UNVERIFIED is the only issue: the spec CS150 is a draft with rows not grade A).",
  "unbuilt": [],
  "validates": ["VC-RTE-01", "VC-RTE-02", "VC-RTE-03", "VC-RTE-17"],
  "description": "Pump P-101 top discharge (DN100 CL150 RF flanged nozzle at z 1000, facing +Z) to vertical vessel V-101 side inlet N1 (DN100 CL150 RF, face at x 6000, facing -X). Spec CS150. Route by compass legs: up 1500, +Y 3000, +X 3000, up 1500, then +X into the nozzle (3000). Four LR 90 elbows, a weld-neck flange + gasket + bolt set at each nozzle.",
  "units": "mm",
  "actions": [
    { "command": "import_piping_catalog", "params": { "catalog": "<data/catalog_stub_cs150.json>" } },
    { "command": "import_pipe_spec", "params": { "spec": "<data/spec_cs150.json>" } },
    {
      "command": "add_equipment",
      "params": { "name": "Centrifugal pump", "mark": "P-101", "location": [0, -300], "size": [1200, 600, 800], "weight": 650 },
      "as": "pump"
    },
    {
      "command": "add_nozzle",
      "params": {
        "equipment": "P-101",
        "mark": "N2",
        "dn": 100,
        "rating": "CL150",
        "facing": "RF",
        "location": { "on": "free", "position": [0, 300, 1000], "direction": [0, 0, 1] },
        "projection": 300
      },
      "as": "pumpOut",
      "note": "free location in the equipment frame (origin = plan location of P-101): world face centre (0, 0, 1000) facing +Z; the port is P-101:N2"
    },
    {
      "command": "add_vessel",
      "params": {
        "tag": "V-101",
        "name": "Feed drum",
        "orientation": "vertical",
        "location": [7000, 3000],
        "insideDiameter": 1600,
        "tangentLength": 4000,
        "heads": { "top": { "type": "ellipsoidal", "ratio": 2 }, "bottom": { "type": "ellipsoidal", "ratio": 2 } },
        "shellThickness": 10,
        "headThickness": 10,
        "corrosionAllowance": 3,
        "support": { "type": "skirt", "height": 1000, "thickness": 10 },
        "design": {
          "pressure": { "value": 1, "unit": "MPa" },
          "temperatureC": 150,
          "material": "SA-516 Gr 70",
          "allowableStress": { "value": 137.9, "unit": "MPa", "source": "user input" },
          "jointEfficiency": { "shell": 1, "heads": 1 },
          "materialDensityKgM3": 7850
        }
      },
      "as": "vessel"
    },
    {
      "command": "add_nozzle",
      "params": {
        "equipment": "V-101",
        "mark": "N1",
        "dn": 100,
        "rating": "CL150",
        "facing": "RF",
        "location": { "on": "shell", "elevation": 3000, "orientationDeg": 270 },
        "projection": 1000
      },
      "as": "vesselIn",
      "note": "shell nozzle, orientation 270 deg (west, north_cw) at 1000 mm from the axis: world face centre (6000, 3000, 4000) facing -X; skirt 1000 + elevation 3000 = z 4000; the port is V-101:N1"
    },
    {
      "command": "create_pipeline",
      "params": {
        "service": "P",
        "sequence": "1001",
        "spec": "CS150",
        "dn": 100,
        "from": "P-101:N2",
        "to": "V-101:N1",
        "designTempC": 60,
        "designPressureBarG": 10
      },
      "as": "line"
    },
    {
      "command": "route_pipe",
      "params": {
        "lineId": "$line",
        "from": { "portId": "P-101:N2" },
        "to": { "portId": "V-101:N1" },
        "legs": [
          { "direction": "+Z", "length": 1500 },
          { "direction": "+Y", "length": 3000 },
          { "direction": "+X", "length": 3000 },
          { "direction": "+Z", "length": 1500 }
        ]
      },
      "as": "run"
    },
    { "command": "check_piping", "params": { "lineIds": ["$line"] } },
    { "command": "piping_takeoff", "params": { "runId": "$run" } }
  ],
  "expected": [
