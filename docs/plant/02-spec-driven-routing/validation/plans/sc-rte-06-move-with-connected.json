    { "step": 9, "path": "data.legs[4].lengthMm", "value": 3500, "abs": 0.000001, "source": "3000 + 500" },
    { "step": 10, "path": "summary", "contains": "re-routed 1 run" },
    {
      "step": 11,
      "path": "data.pipePieces[*].cutLengthMm",
      "value": [1269, 3196, 2696, 1196, 3269],
      "abs": 0.01,
      "source": "+Y leg 3000 + 500 - 2 x 152 = 3196; PI2, PI3, PI4 move +500 Y (legs 2, 3, 4 are perpendicular to Y); every other piece unchanged"
    },
    { "step": 11, "path": "data.legs[1].lengthMm", "value": 3500, "abs": 0.000001, "source": "3000 + 500" },
    { "step": 11, "path": "data.counts.elbow90LR", "value": 4, "source": "topology unchanged" },
    { "step": 11, "path": "data.totalPipeMm", "value": 11626, "abs": 0.01, "source": "1269 + 3196 + 2696 + 1196 + 3269" }
  ]
}
