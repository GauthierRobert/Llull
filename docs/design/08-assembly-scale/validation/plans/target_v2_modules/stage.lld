# Target syntax (M4b/M4c): one compressor stage as a module with typed parameters.
module stage(x0: length, hubR: length, tipR: length, rotors: int, stators: int, pitch: length = 25.75) {
  fn r(t) = hubR + t*(tipR - hubR)
  revolve_profile disk profile=[[200, x0-14], [hubR, x0-14], [hubR, x0+14], [200, x0+14]] axis="x"
  airfoil_from_naca sec designation="6507" as="nurbs" points=31 trailingEdge="closed" chord=30 incidenceDeg=-38 position=[x0-15, 0, hubR+2]
  airfoil_from_naca tip designation="4505" as="nurbs" points=31 trailingEdge="closed" chord=30 incidenceDeg=-52 position=[x0-15, 0, tipR-2]
  loft_sections blade sectionIds=[sec.entity, tip.entity]
  array_polar blades id=blade count=rotors center=[0,0,0] axis=[1,0,0] as="instances"
  add_connection_group bladed kind="bolted" members={patternOf: blade} detect={toleranceMm: 0.01} reason="platform on disk rim"
  revolve_profile casing profile=[for i in 0..<8: [r(1) + (if i mod 2 == 0 then 0 else 1.5), x0 - pitch/2 + i*pitch/4]] axis="x"
  export disk, blades, casing
}
