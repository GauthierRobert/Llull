   "source": "data/offset_shell_cases.json (eps 0.01 bound)"
  }
 },
 "actions": [
  {
   "command": "set_units",
   "params": {
    "units": "mm"
   }
  },
  {
   "command": "convex_hull",
   "params": {
    "points": [
     [
      0,
      0,
      0
     ],
     [
      10,
      0,
      0
     ],
     [
      0,
      10,
      0
     ],
     [
      10,
      10,
      0
     ],
     [
      0,
      0,
      10
     ],
     [
      10,
      0,
      10
     ],
     [
      0,
      10,
      10
     ],
     [
      10,
      10,
      10
     ],
     [
      5,
      5,
      5
     ],
     [
      2,
      7,
      3
     ]
    ]
   },
   "as": "hull"
  },
  {
   "command": "mass_properties",
   "params": {
    "entityId": "$hull"
   }
  },
  {
   "command": "add_box",
   "params": {
    "size": [
     10,
     10,
     10
