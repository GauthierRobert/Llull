  },
  {
   "command": "mass_properties",
   "params": {
    "entityId": "$rounded"
   }
  },
  {
   "command": "add_box",
   "params": {
    "size": [
     3,
     3,
     3
    ],
    "anchor": "center"
   },
   "as": "small"
  },
  {
   "command": "minkowski_sum",
   "params": {
    "a": "$cube",
    "b": "$small",
    "op": "sum",
    "keepSources": true
   },
   "as": "grown"
  },
  {
   "command": "minkowski_sum",
   "params": {
    "a": "$cube",
    "b": "$small",
    "op": "difference",
    "keepSources": true
   },
   "as": "eroded"
  },
  {
   "command": "add_sphere",
   "params": {
    "radius": 10,
    "position": [
     40,
     0,
     0
    ]
   },
   "as": "sphere"
  },
  {
   "command": "offset_mesh",
   "params": {
    "id": "$sphere",
    "distance": 1,
    "method": "level_set",
    "tolerance": 0.01
   },
   "as": "grownSphere"
  },
  {
   "command": "mass_properties",
   "params": {
    "entityId": "$grownSphere"
   }
  }
 ]
