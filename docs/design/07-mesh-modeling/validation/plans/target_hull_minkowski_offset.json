{
 "id": "MSH-HULL-MINK",
 "status": "DRAFT: needs the proposed commands in `unbuilt`",
 "unbuilt": [],
 "notes": [
  "the ball and the sphere are imported fine icospheres (binary STL, generate_mesh_algorithms.mjs section 6): the display tessellation of add_sphere has 4 % less volume than the sphere, far outside the VC-MSH-15 bound",
  "maxCells 100000 coarsens the level-set grid (edge about 0.5): the result reports data.toleranceMet false and data.errorBound = area x edge; the measured deviation is still inside area x 0.01"
 ],
 "validates": [
  "VC-MSH-11",
  "VC-MSH-12",
  "VC-MSH-13",
  "VC-MSH-14",
  "VC-MSH-15"
 ],
 "description": "Closed-form cases: hull of points, cube (+) ball, cube (+) cube, cube (-) cube, offsets of a sphere and a cube.",
 "expect": {
  "convex_hull data.volume": {
   "value": 1000,
   "tolerance": 1e-9,
   "relative": true,
   "source": "data/convex_hull_cases.json cube_plus_interior"
  },
  "minkowski cube+icosphere(l2) volume": {
   "value": 2601.81399162,
   "tolerance": 1e-9,
   "relative": true,
   "source": "data/minkowski_cases.json polyhedral level 2"
  },
  "minkowski cube+cube volume": {
   "value": 2197,
   "tolerance": 1e-9,
   "relative": true
  },
  "minkowski difference cube-cube volume": {
   "value": 343,
   "tolerance": 1e-9,
   "relative": true
  },
  "offset sphere +1 volume": {
   "value": 5575.27976257,
   "tolerance": 0.00272727,
   "relative": true,
   "source": "data/offset_shell_cases.json (eps 0.01 bound)"
  }
 },
 "actions": [
  {
   "command": "set_units",
   "params": {
    "units": "mm"
   }
  },
  {
   "command": "convex_hull",
   "params": {
    "points": [
     [
      0,
      0,
      0
     ],
     [
      10,
      0,
      0
     ],
     [
      0,
      10,
      0
     ],
     [
      10,
      10,
      0
     ],
     [
      0,
      0,
      10
     ],
     [
      10,
      0,
      10
     ],
     [
      0,
      10,
      10
     ],
     [
      10,
      10,
      10
     ],
     [
      5,
      5,
      5
     ],
     [
      2,
      7,
      3
     ]
    ]
   },
   "as": "hull"
  },
  {
   "command": "mass_properties",
   "params": {
    "entityId": "$hull"
   }
  },
  {
   "command": "add_box",
   "params": {
    "size": [
     10,
     10,
     10
    ],
    "anchor": "min"
   },
   "as": "cube"
  },
  {
   "command": "import_mesh_file",
   "params": {
    "format": "stl",
    "file": "validation/data/icosphere_r2_l2_binary.stl",
    "units": "mm"
   },
   "as": "ball"
  },
  {
   "command": "minkowski_sum",
   "params": {
    "a": "$cube",
    "b": "$ball",
    "op": "sum",
    "keepSources": true
   },
   "as": "rounded"
  },
  {
   "command": "mass_properties",
   "params": {
    "entityId": "$rounded"
   }
  },
  {
   "command": "add_box",
   "params": {
    "size": [
     3,
     3,
     3
    ],
    "anchor": "center"
   },
   "as": "small"
  },
  {
   "command": "minkowski_sum",
   "params": {
    "a": "$cube",
    "b": "$small",
    "op": "sum",
    "keepSources": true
   },
   "as": "grown"
  },
  {
   "command": "minkowski_sum",
   "params": {
    "a": "$cube",
    "b": "$small",
    "op": "difference",
    "keepSources": true
   },
   "as": "eroded"
  },
  {
   "command": "import_mesh_file",
   "params": {
    "format": "stl",
    "file": "validation/data/icosphere_r10_l5_binary.stl",
    "units": "mm"
   },
   "as": "sphere"
  },
  {
   "command": "offset_mesh",
   "params": {
    "id": "$sphere",
    "distance": 1,
    "method": "level_set",
    "tolerance": 0.01,
    "maxCells": 100000
   },
   "as": "grownSphere"
  },
  {
   "command": "mass_properties",
   "params": {
    "entityId": "$grownSphere"
   }
  }
 ]
}
