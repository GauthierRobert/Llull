      0,
      25,
      0
     ],
     [
      0,
      25,
      1
     ]
    ]
   }
  }
 },
 {
  "command": "add_fea_constraint",
  "params": {
   "analysisId": "$an",
   "name": "cyl_x",
   "kind": "displacement",
   "dofs": {
    "ux": 0
   },
   "target": {
    "entityId": "$halfcyl",
    "pointsNear": [
     [
      0,
      50,
      0.5
     ]
    ]
   }
  }
 },
 {
  "command": "add_fea_load",
  "params": {
   "analysisId": "$an",
   "name": "line_load",
   "kind": "force",
   "loadCase": "LC1",
   "category": "limit",
   "target": {
    "entityId": "$halfcyl",
    "facesNear": [
     [
      0,
      50,
      0.5
     ]
    ]
   },
   "vector": [
    0,
    -35000,
    0
   ],
   "distribution": "total"
  },
  "_note": "35 000 N on a 1 mm slice = 35 000 N/mm (SSNP154: 17 500 on its symmetric half)"
 },
 {
  "command": "add_contact_pair",
  "params": {
   "analysisId": "$an",
   "name": "roller_block",
   "slave": {
    "entityId": "$halfcyl",
    "facesNear": [
     [
      0,
      0,
      0.5
     ]
    ]
   },
   "master": {
    "entityId": "$block",
    "facesNear": [
     [
      0,
      0,
      0.5
     ]
    ]
   },
   "formulation": "surface_to_surface",
   "behaviour": {
    "kind": "linear",
    "slope": 3500000.0
   },
   "adjust": {
    "kind": "clearance",
    "value": 0.001
   }
  },
  "_note": "penalty slope 50 x E_block (ccx default rule for node-to-face, applied explicitly here and named)"
 },
 {
  "command": "set_nonlinear_controls",
  "params": {
   "analysisId": "$an",
   "nlgeom": false,
   "convergence": {
    "name": "ccx_default"
   },
   "outputIncrements": "last_per_step",
   "thresholds": {}
  }
 },
 {
  "command": "add_analysis_step",
  "params": {
   "analysisId": "$an",
   "name": "press",
   "multipliers": {
    "LC1": 1.0
   },
   "amplitude": "ramp",
   "control": {
    "kind": "load",
    "initialIncrement": 0.1,
    "minIncrement": 1e-05,
    "maxIncrement": 0.25,
    "maxIncrements": 200
   }
  }
 },
 {
  "command": "set_mesh_controls",
  "params": {
   "analysisId": "$an",
   "elementFamily": "hex_dominant",
   "order": 1,
   "globalSize": 5.0,
   "refinements": [
    {
     "target": {
      "entityId": "$block",
      "facesNear": [
       [
        0,
        0,
        0.5
       ]
      ]
     },
     "size": 0.25
    },
    {
     "target": {
      "entityId": "$halfcyl",
      "facesNear": [
       [
        0,
        0,
        0.5
       ]
      ]
     },
     "size": 0.25
    }
   ]
  },
  "_note": "linear elements: ccx pretension/contact rules favour linear faces; refinement 0.25 mm ~ b/25"
 }
