  { "command": "add_result_probe", "params": { "analysisId": "$an", "name": "iface_x50", "point": [50, 5, 0], "quantity": "u_z" } },
  { "command": "add_result_probe", "params": { "analysisId": "$an", "name": "iface_x70", "point": [70, 5, 0], "quantity": "u_z" } }
