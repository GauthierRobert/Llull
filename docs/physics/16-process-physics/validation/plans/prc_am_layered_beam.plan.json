  },
  {
    "command": "add_fea_constraint",
    "params": {
      "analysisId": "$an",
      "name": "p2",
      "kind": "displacement",
      "dofs": { "ux": 0, "uz": 0 },
      "target": { "entityId": "$plate", "pointsNear": [[50, 10, -4]] }
    }
  },
  {
    "command": "add_fea_constraint",
    "params": {
      "analysisId": "$an",
      "name": "p3",
      "kind": "displacement",
      "dofs": { "uz": 0 },
      "target": { "entityId": "$plate", "pointsNear": [[0, 0, -4]] }
    }
  },
  {
    "command": "am_build_setup",
    "params": { "analysisId": "$an", "buildDirection": [0, 0, 1], "plateEntityId": "$plate", "supportEntityIds": [], "layerHeight": 0.2 }
  },
  {
    "command": "set_inherent_strain",
    "params": {
      "analysisId": "$an",
      "exx": -0.002,
      "eyy": 0,
      "ezz": 0,
      "source": "VC-PRC-30 test input (not a process datum)",
