  }
 },
 {
  "command": "add_imperfection",
  "params": {
   "analysisId": "$an",
   "fromAnalysisId": "$bk",
   "modes": [
    {
     "mode": 1,
     "amplitude": 0.5
    }
   ],
   "amplitudeSource": "validation case VC-NLS-50 test input (not a design rule)"
  },
  "_note": "the buckling case must be meshed and solved first on the same mesh (fea_mesh + fea_solve between the two parts of this plan); without amplitude it is refused with NLS_IMPERFECTION_AMPLITUDE_UNSET (VC-NLS-62)"
 },
 {
