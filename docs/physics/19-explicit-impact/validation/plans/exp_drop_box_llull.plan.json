  },
  {
    "command": "add_material_model",
    "params": {
      "material": "aluminium_like",
      "id": "elastic",
      "model": { "kind": "elastic_isotropic", "E": { "value": 70000, "unit": "MPa" }, "nu": { "value": 0.33, "unit": "1" } },
      "basis": "company",
      "source": { "citation": "test input of this validation case (not a material claim)" }
    }
  },
  {
    "command": "define_constitutive_set",
    "params": { "material": "aluminium_like", "set": { "id": "set", "elastic": "elastic" }, "makeDefault": true }
