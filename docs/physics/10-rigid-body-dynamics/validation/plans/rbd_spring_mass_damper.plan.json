[
  { "command": "set_units", "params": { "units": "mm" } },
  { "command": "add_box", "params": { "size": [20, 20, 20], "position": [100, 0, 0], "anchor": "center" }, "as": "mass_box" },
  { "command": "add_rigid_body", "params": { "entityIds": ["$mass_box"], "id": "mass", "massKg": 1.0 } },
  {
    "command": "add_body_joint",
    "params": {
      "kind": "prismatic",
      "child": "mass",
      "parent": "ground",
      "anchor": [100, 0, 0],
      "axis": [1, 0, 0],
      "stiffness": 1000.0,
      "damping": 2.0,
      "springReference": -0.01,
      "id": "slide"
    }
  },
  { "command": "set_gravity", "params": { "gravity": [0, 0, 0] } },
  {
    "command": "simulate_motion",
    "params": { "duration": 1.0, "timestep": 0.0001, "sampleRate": 5000, "detail": "series", "energy": true, "reactions": "off" }
  }
]
