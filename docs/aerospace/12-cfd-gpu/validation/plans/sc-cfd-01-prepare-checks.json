{
  "id": "SC-CFD-01",
  "status": "draft — the cfd commands are specified, not implemented",
  "validates": ["VC-CFD-10", "VC-CFD-11", "VC-CFD-12"],
  "description": "Geometry preparation only (no solve): a sphere passes and reports a voxel-volume error inside the derived bound; an open mesh fails the watertight check; a 1:1:2 building gets the COST 732 / AIJ domain and a 0.79 % blockage",
  "actions": [
    { "command": "set_units", "params": { "units": "m" } },
    { "command": "add_sphere", "params": { "radius": 0.5, "position": [0, 0, 0] }, "as": "ball" },
    {
      "command": "cfd_create_case",
      "params": { "id": "ball", "entityIds": ["$ball"], "regime": "low_speed", "freestream": { "speedMS": 1, "alphaDeg": 0, "betaDeg": 0 }, "reference": { "areaM2": 0.7853981634, "lengthM": 1, "momentPointM": [0, 0, 0] }, "domain": { "rule": "external_aero" }, "ground": { "enabled": false, "moving": false }, "quality": "draft", "cellsPerReferenceLength": 64 }
    },
    { "command": "cfd_prepare", "params": { "caseId": "ball" } },
    {
      "command": "import_mesh",
      "params": { "bodies": [{ "name": "open box (top face missing)", "positions": [3,0,0, 4,0,0, 4,1,0, 3,1,0, 3,0,1, 4,0,1, 4,1,1, 3,1,1], "indices": [0,2,1, 0,3,2, 0,1,5, 0,5,4, 1,2,6, 1,6,5, 2,3,7, 2,7,6, 3,0,4, 3,4,7] }] },
      "as": "openBox"
    },
    {
      "command": "cfd_create_case",
      "params": { "id": "open", "entityIds": ["$openBox"], "regime": "low_speed", "freestream": { "speedMS": 1, "alphaDeg": 0, "betaDeg": 0 }, "reference": { "areaM2": 1, "lengthM": 1, "momentPointM": [3.5, 0.5, 0.5] }, "domain": { "rule": "external_aero" }, "ground": { "enabled": false, "moving": false }, "quality": "draft" }
    },
    { "command": "cfd_prepare", "params": { "caseId": "open" } },
    { "command": "add_box", "params": { "size": [1, 1, 2], "position": [10, 0, 0], "anchor": "min" }, "as": "tower" },
    {
      "command": "cfd_create_case",
      "params": { "id": "tower", "entityIds": ["$tower"], "regime": "low_speed", "freestream": { "speedMS": 10, "alphaDeg": 0, "betaDeg": 0 }, "reference": { "areaM2": 2, "lengthM": 2, "momentPointM": [10.5, 0.5, 0] }, "domain": { "rule": "buildings" }, "ground": { "enabled": true, "moving": false }, "quality": "draft" }
    },
    { "command": "cfd_prepare", "params": { "caseId": "tower" } }
  ],
  "expected": [
    { "step": 3, "path": "checks[code=CFD_GEOMETRY_NOT_WATERTIGHT].status", "value": "pass" },
    { "step": 3, "path": "surface.voxelVolumeRelativeError", "max": 0.0811899, "source": "derived bound A*(sqrt(3)/2)h / V at 32 cells per radius (data/analytic_references.json voxelSphere)" },
    { "step": 6, "path": "checks[code=CFD_GEOMETRY_NOT_WATERTIGHT].status", "value": "fail" },
    { "step": 6, "path": "checks[code=CFD_GEOMETRY_NOT_WATERTIGHT].openEdges", "value": 4, "source": "the 4 edges of the missing top face" },
    { "step": 9, "path": "domain.box.max[2]", "value": 12, "abs": 1e-9, "source": "H + 5H with H = 2 (COST 732 / AIJ)" },
    { "step": 9, "path": "blockageRatio", "value": 0.007936507937, "rel": 1e-6, "source": "closed form, data/analytic_references.json blockage" },
    { "step": 9, "path": "checks[code=CFD_BLOCKAGE_TOO_HIGH].status", "value": "pass" }
  ]
}
