   "source": "Tsai & Hahn 1980 via Kaw Table 2.1 (density illustrative)" } },
 { "command": "define_rosette", "params": { "name": "R0", "origin": [0, 0, 0], "axis0": [1, 0, 0], "normal": [0, 0, 1], "method": "translational" }, "as": "ros" },
 { "command": "create_composite_part", "params": { "name": "Skin panel", "toolSurface": { "entityId": "$tool", "faceNear": [300, 200, 0] }, "rosette": "R0",
