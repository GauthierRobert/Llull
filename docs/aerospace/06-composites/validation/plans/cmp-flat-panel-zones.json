 { "command": "define_zone", "params": { "part": "$part", "name": "Z-base", "boundary": [[0, 0], [600, 0], [600, 400], [0, 400]], "laminate": "[45/-45/0/90]s", "priority": 0 } },
 { "command": "define_zone", "params": { "part": "$part", "name": "Z-pad", "boundary": [[200, 100], [400, 100], [400, 300], [200, 300]], "laminate": "[45/-45/0/90/0/-45/45/0]s", "priority": 1 } },
 { "command": "define_zone", "params": { "part": "$part", "name": "Z-hole", "boundary": [[260, 160], [340, 160], [340, 240], [260, 240]], "laminate": "[45/-45/0/90/0/-45/45/0/45/-45/0/90]s", "priority": 2 } },
 { "command": "set_ply_drop_rules", "params": { "part": "$part", "rampRatio": 20, "minStagger": 3, "staggerUnit": "dropped_thickness", "dropOrder": "inner_first", "coverPlies": 2 } },
 { "command": "generate_plies_from_zones", "params": { "part": "$part", "material": "T300_5208", "sequencePrefix": "S" } },
 { "command": "core_sample", "params": { "part": "$part", "point": [50, 50, 0] } },
 { "command": "core_sample", "params": { "part": "$part", "point": [300, 200, 0] } },
 { "command": "check_laminate_rules", "params": { "part": "$part" } },
 { "command": "analyze_laminate", "params": { "part": "$part", "point": [50, 50, 0], "loads": { "Nx": 1 }, "criteria": ["max_stress", "tsai_hill", "tsai_wu"] } },
 { "command": "check_layup", "params": { "part": "$part", "purpose": "design" } },
 { "command": "export_ply_flat_patterns_dxf", "params": { "part": "$part", "labels": ["name", "orientation", "sequence"] } },
