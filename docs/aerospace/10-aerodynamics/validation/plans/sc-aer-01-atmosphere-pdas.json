    { "step": 1, "path": "pressurePa", "value": 79.779, "rel": 0.0001, "source": "PDAS" },
    { "step": 1, "path": "speedOfSoundMS", "value": 329.8, "rel": 0.0001, "source": "PDAS" }
  ]
}
