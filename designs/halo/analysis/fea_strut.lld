# HALO v3 — one vane strut under a 5 g hard landing (CalculiX static) and its first natural frequency (modal)
# Strut = halo_v3.lld: NACA 0012, 24 mm chord (along -Z), 215 mm span (along +X, root on the axis, tip in the ring rib).
# Load: the pod (battery, motors, avionics ~0.86 kg, llull BOM) decelerates at 5 g on touchdown and hangs on 8 struts:
# 0.86 kg * 5 * 9.81 / 8 = 5.3 N at the root end, limit load (ultimate factor 1.5 applied by compute_margins).
# Material: CFRP skins (2 x 0.1 mm UD along the span + 1 x 0.1 mm ±45) on Rohacell 110, homogenised as in
# fea_rotor_loop.lld: E_eq = 70 GPa * 0.36 ≈ 25 GPa, strain allowable 4000 µε -> 100 MPa (company value).
design halo_strut_fea units=mm
param strutChord = 24
param span = 215
param rootLoad = 5.3
draw_naca_airfoil vs naca="0012" chord=strutChord pointsPerSide=24
extrude_profile strut id=vs depth=span axis=[1, 0, 0]
create_material _ name=strut_sandwich_eq density=0.45 densityUnit=g/cm^3
add_material_model _ material=strut_sandwich_eq id=elastic model={"kind":"elastic_isotropic","E":{"value":25,"unit":"GPa"},"nu":{"value":0.3,"unit":"1"}} validity=[{"variable":"T","unit":"degC","data":[-20,60]}] basis=company source.citation="HALO homogenised strut sandwich: E_skin 70 GPa (T700 UD-dominant, typical) x bending-stiffness ratio 0.36"
define_constitutive_set _ material=strut_sandwich_eq set.id=linear set.elastic=elastic makeDefault=true
set_material_property _ material=strut_sandwich_eq property=Ftu value=100 unit=MPa basis=company source.citation="4000 microstrain CFRP design strain x E_eq 25 GPa (HALO strain allowable)"
set_material_property _ material=strut_sandwich_eq property=Fty value=100 unit=MPa basis=company source.citation="4000 microstrain CFRP design strain x E_eq 25 GPa (HALO strain allowable)"
assign_material _ materialName=strut_sandwich_eq entityIds=[strut]
set_part_grounded _ ids=[strut] grounded=true

create_analysis landing name="Strut, 5 g hard landing" analysisType=static
set_part_idealization _ analysisId=landing entityId=strut idealization=solid
set_mesh_controls _ analysisId=landing globalSize=1.5 order=2
add_fea_constraint rib analysisId=landing name=ring_rib kind=fixed target.entityId=strut target.facesNear=[[span, 0, -strutChord/3]]
add_fea_load podload analysisId=landing name=pod_5g kind=force target.entityId=strut target.facesNear=[[0, 0, -strutChord/3]] vector=[0, 0, -rootLoad]

create_analysis strutModes name="Strut modes (hub + rib clamped)" analysisType=modal modes=3
set_part_idealization _ analysisId=strutModes entityId=strut idealization=solid
set_mesh_controls _ analysisId=strutModes globalSize=1.5 order=2
add_fea_constraint rib2 analysisId=strutModes name=ring_rib kind=fixed target.entityId=strut target.facesNear=[[span, 0, -strutChord/3]]
add_fea_constraint hub2 analysisId=strutModes name=root_hub kind=fixed target.entityId=strut target.facesNear=[[0, 0, -strutChord/3]]   # as built: bonded into the 8-strut root hub

check check_analysis analysisId=landing path=items.0.code expect == "FEA_MESH_MISSING"   # set-up complete; fea_mesh + fea_solve run on the host (Gmsh + CalculiX)
