is=company source.citation=\"HALO homogenised strut sandwich: E_skin 70 GPa (T700 UD-dominant, typical) x bending-stiffness ratio 0.36\"\ndefine_constitutive_set _ material=strut_sandwich_eq set.id=linear set.elastic=elastic makeDefault=true\nset_material_property _ material=strut_sandwich_eq property=Ftu value=100 unit=MPa basis=company source.citation=\"4000 microstrain CFRP design strain x E_eq 25 GPa (HALO strain allowable)\"\nset_material_property _ material=strut_sandwich_eq property=Fty value=100 unit=MPa basis=company source.citation=\"4000 microstrain CFRP design strain x E_eq 25 GPa (HALO strain allowable)\"\nassign_material _ materialName=strut_sandwich_eq entityIds=[strut]\nset_part_grounded _ ids=[strut] grounded=true\n\ncreate_analysis landing name=\"Strut, 5 g hard landing\" analysisType=static\nset_part_idealization _ analysisId=landing entityId=strut idealization=solid\nset_mesh_controls _ analysisId=landing globalSize=1.5 order=2\nadd_fea_constraint rib analysisId=landing name=ring_rib kind=fixed target.entityId=strut target.facesNear=[[span, 0, -strutChord/3]]\nadd_fea_load podload analysisId=landing name=pod_5g kind=force target.entityId=strut target.facesNear=[[0, 0, -strutChord/3]] vector=[0, 0, -rootLoad]\n\ncreate_analysis strutModes name=\"Strut modes (hub + rib clamped)\" analysisType=modal modes=3\nset_part_idealization _ analysisId=strutModes entityId=strut idealization=solid\nset_mesh_controls _ analysisId=strutModes globalSize=1.5 order=2\nadd_fea_constraint rib2 analysisId=strutModes name=ring_rib kind=fixed target.entityId=strut target.facesNear=[[span, 0, -strutChord/3]]\nadd_fea_constraint hub2 analysisId=strutModes name=root_hub kind=fixed target.entityId=strut target.facesNear=[[0, 0, -strutChord/3]]   # as built: bonded into the 8-strut root hub\n\ncheck check_analysis analysisId=landing path=items.0.code expect == \"FEA_MESH_MISSING\"   # set-up complete; fea_mesh + fea_solve run on the host (Gmsh + CalculiX)\n","reads":{"strutC