{
  "name": "llull",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "llull \u2014 a modern, MCP-first 3D CAD app whose every operation is one command drivable by UI, AI, or any MCP agent.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,cjs,js}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p tests/quality && tsc --noEmit -p tests/production",
    "claude:lint": "node .claude/hooks/claude-lint.mjs",
    "arch": "depcruise packages src server/src desktop/src --config .dependency-cruiser.cjs --output-type err",
    "check": "npm run typecheck && npm run arch && npm run lint && npm run format:check && npm run test",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,cjs,js}\"",
    "test:e2e": "playwright test",
    "quality:fetch": "node quality/fetchCorpus.mjs",
    "quality:step": "npm --prefix server run quality:step",
    "quality:drawings": "npm --prefix server run quality:drawings",
    "quality:display": "playwright test --config playwright.quality.config.ts",
    "quality": "npm run quality:fetch && npm run quality:generate && npm run quality:step && npm run quality:display",
    "quality:generate": "python3 quality/synthetic_step.py",
    "production:scripted": "npm --prefix server run production:scripted",
    "production:agent": "npm --prefix server run production:agent",
    "production:ui": "playwright test --config playwright.production.config.ts",
    "production": "npm run production:scripted && npm run production:ui",
    "llull": "node server/bin/llull.cjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "manifold-3d": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "three-mesh-bvh": "^0.9.10",
    "three-stdlib": "^2.36.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "opencascade.js": "^1.1.1",
    "prettier": "^3.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ]
}
