{
  "name": "llull",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "llull — a local 2D + 3D CAD desktop app whose every operation is one command, drivable from the UI or the llull CLI.",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript-native/bin/tsc -b && vite build",
    "test": "node scripts/heavyLock.mjs test -- vitest run",
    "test:watch": "vitest",
    "test:coverage": "node scripts/heavyLock.mjs test:coverage -- vitest run --coverage",
    "oracle": "node scripts/oracle.mjs",
    "action-matrix": "node scripts/actionMatrix.mjs",
    "lane": "node scripts/lane.mjs",
    "mutation": "node scripts/mutation.mjs",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write \"**/*.{ts,tsx,mts,mjs,cjs,js}\"",
    "typecheck": "node scripts/runParallel.mjs typecheck:app typecheck:tests typecheck:quality typecheck:production",
    "typecheck:app": "node node_modules/typescript-native/bin/tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc7/app.tsbuildinfo",
    "typecheck:tests": "node node_modules/typescript-native/bin/tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc7/tests.tsbuildinfo -p tests",
    "typecheck:quality": "node node_modules/typescript-native/bin/tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc7/quality.tsbuildinfo -p tests/quality",
    "typecheck:production": "node node_modules/typescript-native/bin/tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc7/production.tsbuildinfo -p tests/production",
    "claude:lint": "node .claude/hooks/claude-lint.mjs",
    "arch": "depcruise packages src server/src desktop/src --config .dependency-cruiser.cjs --output-type err",
    "check": "node scripts/heavyLock.mjs check -- \"npm run check:static && npm run test\"",
    "check:static": "npm run typecheck && node scripts/runParallel.mjs arch deadcode lint format:check native:check",
    "check:coverage": "node scripts/heavyLock.mjs check:coverage -- \"npm run check:static && npm run test:coverage\"",
    "check:fast": "node scripts/runParallel.mjs typecheck arch lint && vitest run --changed origin/main",
    "native:check": "node scripts/heavyLock.mjs native:check -- node scripts/nativeCheck.mjs",
    "format:check": "prettier --check --cache \"**/*.{ts,tsx,mts,mjs,cjs,js}\"",
    "test:e2e": "playwright test",
    "quality:fetch": "node quality/fetchCorpus.mjs",
    "quality:step": "npm --prefix server run quality:step",
    "quality:drawings": "npm --prefix server run quality:drawings",
    "quality:physics": "node quality/physicsBenchmarks.mjs",
    "quality:display": "playwright test --config playwright.quality.config.ts",
    "quality": "npm run quality:fetch && npm run quality:generate && npm run quality:step && npm run quality:display",
    "quality:generate": "python3 quality/synthetic_step.py",
    "seed:materials": "node scripts/build-seed-library.mjs",
    "production:scripted": "npm --prefix server run production:scripted",
    "production:agent": "npm --prefix server run production:agent",
    "production:ui": "playwright test --config playwright.production.config.ts",
    "production": "npm run production:scripted && npm run production:ui",
    "llull": "node server/bin/llull.cjs",
    "features": "node scripts/features.mjs",
    "piping-catalog": "node scripts/piping-catalog.mjs",
    "deadcode": "knip --include exports,types"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "manifold-3d": "^3.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "three-stdlib": "^2.36.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "knip": "^6.41.0",
    "prettier": "3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "typescript-native": "npm:typescript@~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ]
}
