# Copy to .env. Config for the optional Express MCP host (server/).
# The app is fully usable offline in the browser; the server only hosts the MCP endpoint.

# Bearer token required on the /mcp endpoint. Unset = endpoint is unprotected (dev only).
MCP_AUTH_TOKEN=

# Port the MCP host listens on (default 3001).
PORT=3001

# --- Web app (Vite, read at build time) ---
# Server base URL the browser talks to (REST, /live SSE, /mcp). Default http://localhost:3001.
VITE_LLULL_SERVER_URL=
# Bearer token the web app sends on REST mutations. Needed only when the server runs with
# LLULL_REQUIRE_TOKEN_FOR_REST=true. It is embedded in the static bundle, so only use it when the
# web app itself is access-controlled.
VITE_LLULL_API_TOKEN=
