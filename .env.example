# Copy to .env (server/ reads it when run by hand; the desktop app sets these itself).
# The llull backend is local-only: it binds loopback and serves the desktop renderer, the REST API and /live.

# Bearer token the backend checks. The desktop app generates one per launch (desktop/src/backendEnv.ts) and passes
# it to the renderer as `#token=`. Unset = no token (dev only).
LLULL_AUTH_TOKEN=

# Port the backend listens on (default 3001; `npm run dev` points the renderer at http://localhost:3001).
PORT=3001
