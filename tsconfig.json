{
  /* Path aliases live in tsconfig.base.json (also read by Vite/Vitest via workspaceAliases.ts). */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    /* No ambient @types (e.g. node): browser code must not see Node globals. */
    "types": [],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness — the whole point of using TS for geometry code */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
  },
  /* Tests type-check under tests/tsconfig.json (Node types). */
  "include": ["src", "packages"]
}
