{
  "id": "05-box-anchor-base",
  "family": "primitive",
  "description": "box anchored by its base centre",
  "source": "analytic",
  "formula": "centre z = base z + c/2",
  "kernels": ["manifold", "occt"],
  "bodies": 1,
  "volume": 24,
  "area": 52,
  "centroid": [0, 0, 3],
  "bbox": { "min": [-1, -1.5, 1], "max": [1, 1.5, 5] },
  "tolerance": { "volume": 0.001, "area": 0.001, "centroid": 0.001, "bbox": 0.001 }
}
