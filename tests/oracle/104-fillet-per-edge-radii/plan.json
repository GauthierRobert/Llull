{
  "actions": [
    { "command": "add_box", "params": { "size": [20, 10, 5] }, "as": "a" },
    {
      "command": "fillet_edge",
      "params": {
        "id": "$a",
        "edges": [
          { "near": [10, 5, 0], "size": 1 },
          { "near": [-10, -5, 0], "size": 2 }
        ]
      }
    }
  ]
}
