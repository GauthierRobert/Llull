    }
  },
  {
    "command": "define_constitutive_set",
    "params": { "material": "steel_beam", "set": { "id": "set", "elastic": "elastic" }, "makeDefault": true }
  },
  {
    "command": "define_property_model",
    "params": {
      "material": "steel_beam",
      "model": {
        "id": "cte",
        "property": "cte",
        "unit": "1/K",
        "variables": [{ "variable": "T", "unit": "K" }],
        "form": { "kind": "constant", "value": 2.3e-5 },
        "validity": [{ "variable": "T", "unit": "K", "data": [100, 1000] }],
