        "source": { "citation": "test input of this validation case (not a material claim)" }
      }
    }
  },
  { "command": "assign_material", "params": { "materialName": "steel_beam", "entityIds": ["$bar"] } },
  {
    "command": "create_analysis",
    "params": {
      "name": "gradient_supported_half",
