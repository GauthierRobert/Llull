{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
  },
  "include": [
    "src",
    "examples",
    "tests",
    "../packages/core/src",
    "../packages/mcp/src",
    "../packages/domain-aec/src",
    "../packages/kernel-manifold/src",
    "../packages/kernel-occt/src",
    "../src/app"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
